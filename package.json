{
  "name": "semiconductor-encyclopedia-nextjs",
  "version": "1.27.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:search": "node scripts/verify-search.mjs",
    "check:data": "node scripts/verify-data.mjs",
    "check": "npm run check:data && npm run check:content && npm run check:enrichment && npm run check:companies && npm run check:companies:media && npm run check:glossary && npm run check:references && npm run check:search && npm run check:visual && npm run check:process && npm run check:industry && npm run check:responsive && npm run check:transition && npm run check:seo && npm run check:interaction && npm run check:contact",
    "check:companies": "node scripts/verify-companies.mjs",
    "check:companies:pages": "node scripts/verify-company-pages.mjs",
    "check:references:companies": "node scripts/audit-reference-links.mjs reports/company-source-link-audit.json --companies",
    "check:enrichment": "node scripts/verify-concept-enrichment.mjs",
    "check:references:enrichment": "node scripts/audit-reference-links.mjs reports/enrichment-source-link-audit.json --enrichment",
    "check:content": "node scripts/verify-content-quality.mjs",
    "check:content:pages": "node scripts/verify-content-pages.mjs",
    "check:references:online": "node scripts/audit-reference-links.mjs",
    "check:visual": "node scripts/verify-visual-guides.mjs",
    "predev": "node scripts/generate-static-metadata.mjs",
    "prebuild": "node scripts/generate-static-metadata.mjs && node scripts/clean-build.mjs",
    "check:process": "node scripts/verify-process-hub.mjs",
    "check:industry": "node scripts/verify-industry-hub.mjs",
    "check:responsive": "node scripts/verify-responsive.mjs",
    "check:seo": "node scripts/generate-static-metadata.mjs && node scripts/verify-seo.mjs",
    "preview": "next start",
    "check:export": "node scripts/verify-export.mjs",
    "check:links": "node scripts/verify-export-links.mjs",
    "build:verify": "npm run build",
    "release:check": "npm run check && npm run build",
    "check:transition": "node scripts/verify-transitions.mjs",
    "check:interaction": "node scripts/verify-interactions.mjs",
    "check:contact": "node scripts/verify-contact.mjs",
    "check:references": "node scripts/verify-references.mjs",
    "check:glossary": "node scripts/verify-glossary.mjs",
    "check:companies:media": "node scripts/verify-company-media.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {}
}
